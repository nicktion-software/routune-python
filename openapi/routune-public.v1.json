  "info": {
    "title": "Routune API",
    "description": "The Routune API lets your systems create and track deliveries in your Routune workspace.\n\n**Authentication.** Create an API key in Settings > API keys and send it on every request as `Authorization: Bearer rtn_live_…`. Keys belong to the workspace and only have the scopes you gave them. Keep them on your server; never ship them in a browser or mobile app.\n\n**Requests and responses.** JSON in snake_case. Ids are UUIDs. Times are ISO 8601 in UTC. Amounts are integers in the currency's smallest unit (cents).\n\n**Lists** are newest first. Pass `limit` (1-100, default 25) and, for the next page, `cursor` = `next_cursor` from the previous response. `has_more` tells you whether there is another page.\n\n**Idempotency.** Send an `Idempotency-Key` header with POST requests to retry safely: the same key and body return the original result instead of creating a second record.\n\n**Errors** have the shape `{ \"error\": { \"type\", \"code\", \"message\", \"request_id\", \"details\" } }`. Quote `request_id` when you contact support.\n\n**Rate limits.** 600 requests a minute per key and 1,200 per workspace. Every response carries `RateLimit-Limit`, `RateLimit-Remaining` and `RateLimit-Reset`; a 429 also carries `Retry-After`.\n\n**Usage.** Successful requests count towards your plan's monthly API requests; extra requests are billed per 1,000.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Orders"
    },
    {
      "name": "Customers"
    },
    {
      "name": "Drivers"
    },
    {
      "name": "Locations"
    },
    {
      "name": "Price sets"
    }
  ],
  "servers": [
    {
      "url": "https://api.routune.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "api-key": {
        "scheme": "bearer",
        "bearerFormat": "API key",
        "type": "http",
        "description": "A workspace API key: rtn_live_… (rtn_test_… on test workspaces)."
      }
    },
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "address_line1": {
            "type": "string",
            "nullable": true
          },
          "address_line2": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "postal_code": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string",
            "nullable": true,
            "example": "US"
          },
          "latitude": {
            "type": "number",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "OrderStop": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "address": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Address"
              }
            ]
          },
          "earliest_time": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "latest_time": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "actual_time": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "DriverRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id"
        ]
      },
      "Dimensions": {
        "type": "object",
        "properties": {
          "length": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        }
      },
      "OrderAmounts": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "example": "usd"
          },
          "base": {
            "type": "number",
            "description": "Minor units (cents)."
          },
          "fuel_surcharge": {
            "type": "number"
          },
          "accessorials": {
            "type": "number"
          },
          "tax": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "currency",
          "base",
          "fuel_surcharge",
          "accessorials",
          "tax",
          "total"
        ]
      },
      "OrderLeg": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_transit",
              "completed",
              "cancelled"
            ]
          },
          "assigned_driver_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "pickup_location_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "dropoff_location_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "sequence",
          "status"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "object": {
            "type": "string",
            "enum": [
              "order"
            ]
          },
          "number": {
            "type": "string",
